{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "pip_requirements"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/",
      "/(^|/)requirements\\.(dev|test|prod)\\.txt$/"
    ]
  }
}
